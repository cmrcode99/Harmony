#!/bin/zsh
set -eu
app="$HOME/Applications/Harmony.app"
usage='Usage: harmony [HOURS [MINUTES]|hide|unhide|exit|phone|setup|uninstall|help] | harmony extend HOURS [MINUTES]'
if (( $# > 3 )); then print -u2 "$usage"; exit 2; fi
action=show
hours=''
minutes=''
parse_duration() {
  (( $# >= 1 && $# <= 2 )) || return 1
  [[ "$1" == [0-5] ]] || return 1
  hours="$1"
  minutes=''
  local duration_minutes=0
  if (( $# == 2 )); then
    [[ "$2" == [0-9] || "$2" == [0-5][0-9] ]] || return 1
    duration_minutes=$(( 10#${2} ))
    minutes="$duration_minutes"
  else
    [[ "$hours" == [1-5] ]] || return 1
  fi
  (( hours * 60 + duration_minutes > 0 && hours * 60 + duration_minutes <= 300 ))
}
case "${1-}" in
  '') if (( $# != 0 )); then print -u2 "$usage"; exit 2; fi ;;
  [0-5])
    if ! parse_duration "$@"; then
      print -u2 'Use hours 0–5 and minutes 0–59, totaling 1 minute to 5 hours. Hours alone must be 1–5.'
      exit 2
    fi
    action=lock ;;
  extend)
    shift
    if ! parse_duration "$@"; then
      print -u2 'Usage: harmony extend HOURS [MINUTES]. Total must be 1 minute to 5 hours; shortening is not allowed.'
      exit 2
    fi
    action=extend ;;
  uninstall)
    if (( $# > 2 )) || [[ -n "${2-}" && "$2" != --remove-data ]]; then print -u2 "$usage"; exit 2; fi
    manager="$HOME/.local/lib/harmony/manage-install.sh"
    [[ -f "$manager" ]] || { print -u2 'The uninstall helper is missing. Run uninstall.sh from the source folder or Uninstall Harmony.command from your package.'; exit 1; }
    exec /bin/zsh "$manager" uninstall "${@:2}" ;;
  setup)
    if (( $# != 1 )); then print -u2 "$usage"; exit 2; fi
    action=setup ;;
  hide|unhide|exit|phone)
    if (( $# != 1 )); then print -u2 "$usage"; exit 2; fi
    action="$1" ;;
  help|--help|-h)
    if (( $# != 1 )); then print -u2 "$usage"; exit 2; fi
    print 'harmony              Start Harmony and prepare approved apps\nharmony 1..5         Start a whole-hour timed session\nharmony H M          Start H hours M minutes (e.g. 2 30 or 0 45)\nharmony extend N [M] Set an active timer to N hours M minutes remaining\nharmony hide         Hide eye and silence audio; keep restrictions/timer\nharmony unhide       Show eye again without changing the timer\nharmony phone        Verify long password and type Screen Time code\nharmony exit         Exit base mode; timed sessions exit through the eye menu\nharmony setup        Open first-run setup while off\nharmony uninstall    Remove the app and command; keep saved settings\nharmony uninstall --remove-data  Also remove saved settings and phone vault\nharmony help         Show this help (also --help or -h)\n\nMinutes must be 0–59. Total duration: 1 minute to 5 hours; 5 0 is valid, 5 1 is not. Hours alone must be 1–5. Extend uses a target from now; it does not add time, shorten, start or revive a session. Start commands refuse an already-running instance. Use unhide to reveal a hidden eye.'
    exit 0 ;;
  *) print -u2 "$usage"; exit 2 ;;
esac
if [[ ! -x "$app/Contents/MacOS/HarmonyFocus" ]]; then
  print -u2 'Harmony is not installed in ~/Applications/Harmony.app.'; exit 1
fi
running_status=0
"$app/Contents/MacOS/HarmonyFocus" --is-running || running_status=$?
if (( running_status > 1 )); then
  print -u2 'Could not inspect Harmony session state. No action was taken.'
  exit 1
fi
if [[ "$action" == setup ]]; then
  if (( running_status == 0 )); then print -u2 'Exit Harmony before changing setup.'; exit 1; fi
  /usr/bin/open "$app" --args --configure-only
  exit 0
fi
duration_args=("$hours")
if [[ -n "$minutes" ]]; then duration_args+=("$minutes"); fi
if (( running_status == 0 )); then
  if [[ "$action" == show || "$action" == lock ]]; then
    print -u2 'Another instance of Harmony is already running.'
    exit 1
  fi
  if [[ "$action" == extend ]]; then
    "$app/Contents/MacOS/HarmonyFocus" --command extend "${duration_args[@]}"
  else
    "$app/Contents/MacOS/HarmonyFocus" --command "$action"
  fi
else
  if [[ "$action" != lock && -n "${1-}" ]]; then
    print -u2 'Harmony is off. Start it with harmony or harmony HOURS [MINUTES] before using control commands.'
    exit 1
  fi
  if [[ "$action" == lock ]]; then
    /usr/bin/open -g "$app" --args --launch-action lock "${duration_args[@]}"
  else
    /usr/bin/open -g "$app" --args --launch-action show
  fi
fi
